{
  "name": "personal-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "@fontsource/pixelify-sans": "^5.1.0",
    "@fontsource/space-mono": "^5.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "2.1.9",
    "@vitest/coverage-v8": "2.1.9",
    "jsdom": "25.0.1",
    "@types/node": "^20.17.0",
    "@playwright/test": "1.48.2"
  }
}
